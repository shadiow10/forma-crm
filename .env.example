# Supabase → Project Settings → API. The publishable/anon key is safe in the browser; RLS protects the data.
# Never put the secret/service_role key in a VITE_ variable: it would ship to every visitor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional: public read-only demo login for the "Essayer la démo" button (see supabase/demo.sql).
# Leave empty to hide the button.
VITE_DEMO_EMAIL=demo@formaplus.test
VITE_DEMO_PASSWORD=
